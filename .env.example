# Copy this file to .env and add your API keys.
# The base URLs below are the defaults; change them only to use a proxy or another endpoint.

# The Guardian: https://open-platform.theguardian.com/access/
VITE_GUARDIAN_KEY=
VITE_GUARDIAN_BASE_URL=https://content.guardianapis.com

# New York Times (Article Search API): https://developer.nytimes.com/get-started
VITE_NYT_KEY=
VITE_NYT_BASE_URL=https://api.nytimes.com/svc/search/v2

# NewsAPI: https://newsapi.org/register
VITE_NEWSAPI_KEY=
VITE_NEWSAPI_BASE_URL=https://newsapi.org/v2
